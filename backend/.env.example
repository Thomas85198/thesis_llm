ANTHROPIC_API_KEY=sk-ant-...

# Recommended default: Sonnet for both. Per-paper cost ~$0.55 vs Opus's ~$3.
# - Haiku for LIGHT made EDUs too coarse (38% drop) — cascades to every layer.
# - For maximum judgment quality, switch HEAVY to claude-opus-4-7.
ANTHROPIC_MODEL_HEAVY=claude-sonnet-4-6
ANTHROPIC_MODEL_LIGHT=claude-sonnet-4-6

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=thesis_demo_pw
