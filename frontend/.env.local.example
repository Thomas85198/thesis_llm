# API base URL for the backend. Baked into the Next.js build at build time.
#
# Local dev:
#   NEXT_PUBLIC_API_BASE=http://localhost:8000
#
# Docker compose on the same host (browser still hits host's 8000):
#   NEXT_PUBLIC_API_BASE=http://localhost:8000
#
# Deployed behind a domain:
#   NEXT_PUBLIC_API_BASE=https://api.lab.example.edu
NEXT_PUBLIC_API_BASE=http://localhost:8000
