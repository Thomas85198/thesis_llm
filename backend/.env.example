# ============================================================
# OpenAI (active provider as of feat/openai-deploy)
# ============================================================
OPENAI_API_KEY=sk-...

# Self-hosted proxy / Azure OpenAI: set OPENAI_BASE_URL.
# Leave commented to use the public OpenAI endpoint.
# OPENAI_BASE_URL=https://api.openai.com/v1

# HEAVY = rule checking + RST/FRU (quality-critical). LIGHT = EDU split + ER
# extraction (prepro). CROSS_SECTION needs long context to fit the whole paper.
# gpt-5.4 family accepts temperature=0 (see LLM_TEMPERATURE below); gpt-5.5 does
# NOT — it forces temperature=1, which makes defect counts non-reproducible.
OPENAI_MODEL_HEAVY=gpt-5.4
OPENAI_MODEL_LIGHT=gpt-5.4-mini
OPENAI_MODEL_CROSS_SECTION=gpt-5.4

# Sampling temperature for ALL LLM calls. Default 0 = greedy decoding, so
# defect verdicts are reproducible run-to-run. Raise only for experiments.
# NOTE: gpt-5.5 rejects any value other than 1 — don't pair it with this.
LLM_TEMPERATURE=0

# Toggle cross-section second pass (REL-04/08/12). 0 disables.
ENABLE_CROSS_SECTION_PASS=1

# ============================================================
# Neo4j
# ============================================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# SECURITY: change this on the lab server!
NEO4J_PASSWORD=thesis_demo_pw

# ============================================================
# Deployment (override on server / docker)
# ============================================================
# Path knobs — leave commented for local dev (defaults to backend/data.db
# and backend/uploads). In Docker, mount /data and set DATA_DIR=/data.
# DATA_DIR=/data
# SQLITE_PATH=/data/data.db
# UPLOAD_DIR=/data/uploads

# CORS — defaults cover any localhost port. For server, set to your domain regex:
#   CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|\[::1\]|lab\.example\.edu)(:\d+)?$
# CORS_ORIGIN_REGEX=

# Frontend URL shown on the API root endpoint as a convenience pointer.
# FRONTEND_URL=http://localhost:3000

# ============================================================
# Anthropic (legacy — preserved for reference, re-enable to switch back)
# ============================================================
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL_HEAVY=claude-sonnet-4-6
# ANTHROPIC_MODEL_LIGHT=claude-sonnet-4-6
# ANTHROPIC_MODEL_CROSS_SECTION=claude-opus-4-7[1m]
